{
  "name": "life-in-the-uk-prep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-seo-files.mjs && vite",
    "generate:seo": "node scripts/generate-seo-files.mjs",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:assets:ios": "npx capacitor-assets generate --ios --iconBackgroundColor '#071f4d' --splashBackgroundColor '#071f4d' --assetPath assets",
    "cap:open": "npx cap open android",
    "cap:build:android": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.3",
    "@supabase/supabase-js": "^2.110.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "workbox-window": "^7.4.1"
  }
}
