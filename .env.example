VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Public site origin used for canonical URLs, Open Graph tags, sitemap and robots.
VITE_SITE_URL=https://lifeintheukprep.co

# Server-only Vercel variables. Never prefix these with VITE_.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ONE_WEEK=price_your_one_week_price
STRIPE_PRICE_TWO_WEEKS=price_your_two_week_price
STRIPE_PRICE_FOUR_WEEKS=price_your_four_week_price
STRIPE_PRICE_LIFETIME=price_your_lifetime_price
# Accepted aliases for the same Price IDs:
# STRIPE_PRICE_1_WEEK=
# STRIPE_PRICE_2_WEEKS=
# STRIPE_PRICE_4_WEEKS=
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
